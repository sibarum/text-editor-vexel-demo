<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.demo</groupId>
    <artifactId>text-editor-vexel-demo</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>text-editor-vexel-demo</name>
    <description>
        A deceptively simple text editor built on vexelray-gui. Standalone client app: depends on the
        framework from the local Maven repo and selects its platform modules via OS-activated profiles,
        the same shape as vexelray-gui-demo.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-gui.version>0.1.0-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.0-SNAPSHOT</vexelray.version>
        <tactroller.version>1.0-SNAPSHOT</tactroller.version>
        <mainframe.version>0.1.0-SNAPSHOT</mainframe.version>

        <app.mainClass>dev.vexelray.demo.editor.TextEditorApp</app.mainClass>
        <!-- Program args for exec:exec. One token each, because a Maven property is not a command line; the
             app drops blanks, so an unused slot costs nothing. Empty app.args = interactive. -->
        <!-- Diagnostics: mvn compile exec:exec "-Dwake.trace=true" traces every frame-loop wake. -->
        <wake.trace>false</wake.trace>
        <app.args></app.args>
        <app.args2></app.args2>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-widget</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Syntax highlighting: TM4E's TextMate tokenizer (NetBeans repack of org.eclipse.tm4e.core,
             the only current release on Maven Central) plus its undeclared runtime deps. -->
        <dependency>
            <groupId>org.netbeans.external</groupId>
            <artifactId>org.eclipse.tm4e.core-0.14.0</artifactId>
            <version>RELEASE260</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.jruby.joni</groupId>
            <artifactId>joni</artifactId>
            <version>2.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>2.7</version>
        </dependency>
        <!-- The terminal window itself, not just the shell behind it. MainFrame ships its console as a
             vexelray-gui component: this application supplies a ConsoleSpec saying what it wants in it (its
             own commands, its own project, its own bottom line) and gets the window. mainframe-core, the shell
             library with zero runtime dependencies of its own, comes in behind it. -->
        <dependency>
            <groupId>dev.mainframe</groupId>
            <artifactId>mainframe-vexel-gui</artifactId>
            <version>${mainframe.version}</version>
        </dependency>
        <!-- The frame clock, for the tab transition. Motion enters at the application edge and nowhere else:
             vexelray-gui-widget declares its timing seam out of JDK types (a DoubleConsumer and a Runnable) and
             this module satisfies it, so Tabs animates without ever naming Kronometer. Brings Kronometer in
             transitively. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-krono</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Native OS open/save dialogs (NFDe over Panama), at the application edge. -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-nfd</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Input at the application edge: the tactroller->atchung bridge. -->
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-atchung</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <dependency>
            <groupId>sibarum.tactroller</groupId>
            <artifactId>tactroller-clipboard</artifactId>
            <version>${tactroller.version}</version>
        </dependency>
        <!-- Tests. TextFile is the one part of this application that is pure policy over bytes - no Gui, no
             window, no clock - so it is the one part a plain JUnit run can hold to its word. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <target>${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <!-- Run: mvn compile exec:exec ; headless capture: mvn compile exec:exec "-Dapp.args=[dash][dash]capture" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>--enable-native-access=ALL-UNNAMED</argument>
                        <argument>-Dvexelray.wake.trace=${wake.trace}</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${app.mainClass}</argument>
                        <argument>${app.args}</argument>
                        <argument>${app.args2}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Build-time platform selection, same as vexelray-gui-demo. -->
        <profile>
            <id>platform-windows</id>
            <activation><os><family>windows</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-windows</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-windows</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation><os><family>unix</family><name>linux</name></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-linux</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-linux</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>platform-macos</id>
            <activation><os><family>mac</family></os></activation>
            <dependencies>
                <dependency>
                    <groupId>dev.vexelray</groupId>
                    <artifactId>vexelray-os-macos</artifactId>
                    <version>${vexelray.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>sibarum.tactroller</groupId>
                    <artifactId>tactroller-macos</artifactId>
                    <version>${tactroller.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!--
          mvn -Pnative package  ->  target/editor.exe

          The switches are the ones mainframe-dist found the hard way, and each is load-bearing. This is the
          editor on its own; the same program also ships inside mainframe.exe, where dist names them again
          because a profile does not travel with a dependency.

          What native-image needs to know beyond the switches is in src/main/resources/META-INF/native-image.
          Two files, kept apart on purpose: one is the traced reflective surface of this application, and
          -signed-jar is a workaround. TM4E ships as a *signed* jar, the Eclipse signing certificate ends up
          in the image heap, and every type needed to represent an X.509 certificate then has to be
          registered or the build fails outright with Type not found during analysis. Deleting those because
          a native image has no jars to verify is the obvious-looking mistake.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- native-image compiles small probe executables and runs them to measure the
                             platform. Windows Application Control blocks a brand-new unsigned .exe under
                             %TEMP%, so the probes are pointed at target/nitmp instead, which this creates. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>make-native-temp-dir</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/nitmp"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.6</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>editor</imageName>
                            <mainClass>${app.mainClass}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                                <!-- The graphics stack and both input backends are Panama downcalls, and Win32
                                     calls back in through an upcall stub for the window procedure. The
                                     signatures themselves are in reachability-metadata.json. -->
                                <buildArg>-H:+ForeignAPISupport</buildArg>
                                <!-- The input backend gives each raw-input registration its own Arena.ofShared,
                                     because the window procedure that reads it runs on a different thread from
                                     the one that opened it. Without this the application runs and then throws
                                     on the way out, when the backend closes them. -->
                                <buildArg>-H:+SharedArenaSupport</buildArg>
                                <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-J-Djava.io.tmpdir=${project.build.directory}/nitmp</buildArg>
                                <!-- No console window. native-image links a console-subsystem executable, so
                                     Windows hands the process a black terminal before anything runs - and
                                     because that console owns the process group, closing it kills the
                                     editor. /ENTRY is not optional alongside it: /SUBSYSTEM:WINDOWS makes
                                     the linker look for WinMain, and the image's entry point is an ordinary
                                     main. Windows linker options; a native build elsewhere drops these two. -->
                                <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:WINDOWS</buildArg>
                                <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
