<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.vexelray.demo</groupId>
    <artifactId>text-editor-vexel-demo</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>text-editor-vexel-demo</name>
    <description>
        A tabbed text editor with a file navigator, on the VexelRay stack.
    </description>

    <!--
      Two modules, split where the dependency edge falls, as vexelray-framework-template's vexel-desktop is:
        text-editor-vexel-demo-core   the controller: the Editor, which decides, and the jobs that touch the disk.
                                      Builds against the framework's annotations, the bus and vexelray-gui-core's
                                      values, and no widget, so its tests need no window.
        text-editor-vexel-demo-gui    the view: the window, the widgets and the framework integration. The entry
                                      point, its wiring, its icons, its fonts and its native build are all here.
      They talk by messages and nothing else (-core's Messages). Run everything from this folder:
      mvn compile exec:exec runs the editor, mvn test runs both modules' tests, and the native profiles build
      text-editor-vexel-demo-gui/target/text-editor.exe.
    -->
    <modules>
        <module>text-editor-vexel-demo-core</module>
        <module>text-editor-vexel-demo-gui</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <vexelray-framework.version>0.1.3-SNAPSHOT</vexelray-framework.version>
        <vexelray-gui.version>0.1.3-SNAPSHOT</vexelray-gui.version>
        <vexelray.version>0.1.3-SNAPSHOT</vexelray.version>
        <tactroller.version>1.3-SNAPSHOT</tactroller.version>
        <vexelray-codec.version>0.1.3-SNAPSHOT</vexelray-codec.version>
        <concordance.version>0.1.3-SNAPSHOT</concordance.version>
        <vex-suite-common.version>0.1.3-SNAPSHOT</vex-suite-common.version>
        <junit.version>5.11.4</junit.version>

        <app.mainClass>dev.vexelray.demo.editor.TextEditor</app.mainClass>

        <!--
          Program args for exec:exec, split on whitespace by the commandlineArgs form below. Empty is the
          interactive run; a multi-word value is several arguments rather than one.
        -->
        <app.args></app.args>

        <!-- The automation driver: "off", "on" for the default port, or a port number. -->
        <automation>off</automation>

        <!--
          Extra JVM flags for exec:exec, split on whitespace. Needed because a -D on the mvn command line sets a
          MAVEN property, which reaches the forked JVM only if the command line below names it: without this,
          "mvn exec:exec -Dmy.setting=48" runs the app with the default and reports a measurement of nothing.
        -->
        <app.jvmArgs></app.jvmArgs>

        <!-- exec:exec runs in every module of the build; only -gui has an application to run, and it says so. -->
        <app.run.skip>true</app.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.vexelray.demo</groupId>
                <artifactId>text-editor-vexel-demo-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Run in a fresh JVM: mvn compile exec:exec
                  exec:exec rather than exec:java so native access can be enabled for Panama FFM.
                  One command line split on whitespace, rather than a list of argument elements. An argument
                  element is exactly one token and a property cannot expand into several, so a multi-word
                  app.args would arrive as a single argument. %classpath is substituted after the split, so it
                  stays one argument even where a path contains a space.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                    <configuration>
                        <skip>${app.run.skip}</skip>
                        <executable>${java.home}/bin/java</executable>
                        <classpathScope>runtime</classpathScope>
                        <commandlineArgs>--enable-native-access=ALL-UNNAMED -Dstdout.encoding=UTF-8 -Dautomation=${automation} "-Dbuild.dir=${project.build.directory}" ${app.jvmArgs} -classpath %classpath ${app.mainClass} ${app.args}</commandlineArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Stamps each module with the exact source of its binaries, and keeps platform-specific code in -windows,
                 -linux and -macos modules only: vexelray-build's identify and isolate (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.3-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>identify</id>
                        <goals>
                            <goal>identify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <!-- The framework's annotation processor, in both modules: what its vocabulary calls a compile error
                         is one in -core as well, where the Editor's mailboxes and the jobs' messages are checked as a
                         library. In -gui it also writes the wiring. Named rather than found, because since JDK 23 javac
                         runs no processor it merely finds on the class path. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>dev.vexelray.framework</groupId>
                            <artifactId>vexelray-framework-processor</artifactId>
                            <version>${vexelray-framework.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <!--
              LWJGL is not part of this stack, and an application that pulls it in is incompatible with the
              framework: the stack owns its windowing and Vulkan through Panama, and LWJGL brings a second
              copy of both. The only module that still uses it, supirvast's vastir-preview, is a dev tool that
              is never installed. So nothing here should reach it, and if something does, this fails the build.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>no-lwjgl</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.lwjgl</exclude>
                                    </excludes>
                                    <message>LWJGL is not part of the VexelRay stack: find which dependency brings it with mvn dependency:tree and remove that edge.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
