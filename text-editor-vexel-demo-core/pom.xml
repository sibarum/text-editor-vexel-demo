<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.vexelray.demo</groupId>
        <artifactId>text-editor-vexel-demo</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>text-editor-vexel-demo-core</artifactId>

    <name>text-editor-vexel-demo-core</name>
    <description>
        The controller: the editor, which decides, and the jobs that touch the disk. Reached only by messages.
    </description>

    <!--
      What the controller may build against, and what it may not. It may use the framework's vocabulary, the bus, and
      vexelray-gui-core's values (a span, a colour, the settings store), all of which are safe from any thread. It may
      not use a widget, the window or the shell: those are -gui's, and a widget here would put the view back inside
      the controller. Nothing enforces that but this list, so a dependency added here is a decision about where the
      line is.
    -->
    <dependencies>
        <!-- @Component, @Job, @Subscribe, @Publishes, @Configuration: checked by the processor while this compiles. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-api</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- The command line's paths (Launch), which the editor opens once the window exists. JDK-only. -->
        <dependency>
            <groupId>dev.vexelray.framework</groupId>
            <artifactId>vexelray-framework-core</artifactId>
            <version>${vexelray-framework.version}</version>
        </dependency>
        <!-- Span, Color and Settings, and through it the bus (atchung-core) and the logger (atchung-probe). -->
        <dependency>
            <groupId>dev.vexelray.gui</groupId>
            <artifactId>vexelray-gui-core</artifactId>
            <version>${vexelray-gui.version}</version>
        </dependency>
        <!-- Syntax highlighting (Grammars): TM4E's TextMate tokenizer, the NetBeans repack of org.eclipse.tm4e.core,
             which is the only current release on Maven Central, and the three runtime dependencies it does not
             declare. A tokenizer and no widget, so it belongs on this side of the line. -->
        <dependency>
            <groupId>org.netbeans.external</groupId>
            <artifactId>org.eclipse.tm4e.core-0.14.0</artifactId>
            <version>RELEASE260</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>
        <dependency>
            <groupId>org.jruby.joni</groupId>
            <artifactId>joni</artifactId>
            <version>2.2.1</version>
        </dependency>
        <dependency>
            <groupId>org.snakeyaml</groupId>
            <artifactId>snakeyaml-engine</artifactId>
            <version>2.7</version>
        </dependency>

        <!-- A folder's build, for Open's picture of it (Survey): Concordance's pom reader, which follows a reactor's
             modules without Maven. Plain JDK, no widget. Installed to the local .m2 by `mvn install` in the sibling
             concordance-indexer repo. -->
        <dependency>
            <groupId>sibarum.concordance</groupId>
            <artifactId>concordance-project</artifactId>
            <version>${concordance.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
