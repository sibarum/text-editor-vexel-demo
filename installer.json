{
  "id": "text-editor",
  "name": "Vex",
  "publisher": "sibarum",
  "description": "A tabbed text editor with a file navigator, on the VexelRay stack.",
  "version": "0.1.0",

  "repo": "sibarum/vexelray-dist",
  "branch": "main",
  "repoPath": "apps/text-editor",
  "releasesRepo": "sibarum/vexelray-dist",
  "tagFormat": "text-editor-v{version}",

  "windows": {
    "binaries": [
      {
        "name": "text-editor",
        "source": "target/text-editor.exe",
        "icon": "src/main/rc/editor.ico",
        "addToPath": true,
        "shortcuts": { "desktop": true, "startMenu": true, "label": "Vex" },
        "fileAssociations": [
          { "extension": ".txt", "description": "Text Document", "contentType": "text/plain", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".log", "description": "Log File", "contentType": "text/plain", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".md", "description": "Markdown Document", "contentType": "text/markdown", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".markdown", "description": "Markdown Document", "contentType": "text/markdown", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".json", "description": "JSON File", "contentType": "application/json", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".jsonc", "description": "JSON with Comments File", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".xml", "description": "XML Document", "contentType": "application/xml", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".xsd", "description": "XML Schema", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".xsl", "description": "XSL Stylesheet", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".yaml", "description": "YAML File", "contentType": "application/yaml", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".yml", "description": "YAML File", "contentType": "application/yaml", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".ini", "description": "Configuration Settings", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".properties", "description": "Properties File", "icon": "src/main/rc/file-data-and-config.ico" },
          { "extension": ".html", "description": "HTML Document", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".htm", "description": "HTML Document", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".css", "description": "CSS Stylesheet", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".mjs", "description": "JavaScript Module", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".cjs", "description": "CommonJS Module", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".java", "description": "Java Source File", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".py", "description": "Python Source File", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".pyi", "description": "Python Stub File", "icon": "src/main/rc/file-source-code.ico" },
          { "extension": ".sh", "description": "Shell Script", "icon": "src/main/rc/file-scripts.ico" },
          { "extension": ".bash", "description": "Bash Script", "icon": "src/main/rc/file-scripts.ico" },
          { "extension": ".psd1", "description": "PowerShell Data File", "icon": "src/main/rc/file-scripts.ico" },
          { "extension": ".diff", "description": "Diff File", "contentType": "text/x-diff", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".patch", "description": "Patch File", "contentType": "text/x-diff", "icon": "src/main/rc/file-plain-text.ico" },
          { "extension": ".dockerfile", "description": "Dockerfile", "icon": "src/main/rc/file-plain-text.ico" }
        ]
      }
    ]
  }
}
